# ─── Database (Neon / Supabase / any Postgres) ──────────────────────
# Pooled connection used by the app at runtime (serverless-friendly).
# Neon: use the "-pooler" host and append ?sslmode=require&pgbouncer=true&connection_limit=1
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=require&pgbouncer=true&connection_limit=1"
# Direct (non-pooled) connection used for `prisma db push` / migrations.
DIRECT_URL="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/neondb?sslmode=require"

# ─── Supabase Auth (REQUIRED in production) ─────────────────────────
# Without these the application refuses to serve /app and /api rather than
# serving them unauthenticated. Project Settings -> API in the Supabase
# dashboard.
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""

# The single account allowed to take ownership of the workspace on first
# sign-in. Everyone else lands with no workspace until an admin invites them.
# Set this to your own email, sign in once, then remove it.
BUILDORA_BOOTSTRAP_OWNER_EMAIL=""

# ─── Email (optional, Resend) ───────────────────────────────────────
RESEND_API_KEY=""

# ─── Local development only ─────────────────────────────────────────
# Skips authentication entirely. The application throws at startup if this is
# set in the Vercel production environment — it must never exist there.
# NEXT_PUBLIC_DEV_AUTH_BYPASS="true"
