# ─── Database (Supabase Postgres or any Postgres) ───────────────────
# Pooled connection string used by the app at runtime
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/constructflow?schema=public"
# Direct (non-pooled) connection used for migrations (Supabase: port 5432)
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/constructflow?schema=public"

# ─── Supabase Auth + Storage ────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# ─── Email (optional, Resend) ───────────────────────────────────────
RESEND_API_KEY=""

# When set to "true", auth middleware is bypassed for local development.
NEXT_PUBLIC_DISABLE_AUTH="true"
