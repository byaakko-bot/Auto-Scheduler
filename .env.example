# ─── Database (Neon / Supabase / any Postgres) ──────────────────────
# Pooled connection used by the app at runtime (serverless-friendly).
# Neon: use the "-pooler" host and append ?sslmode=require&pgbouncer=true&connection_limit=1
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=require&pgbouncer=true&connection_limit=1"
# Direct (non-pooled) connection used for `prisma db push` / migrations.
DIRECT_URL="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/neondb?sslmode=require"

# ─── Supabase Auth + Storage (optional) ─────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""

# ─── Email (optional, Resend) ───────────────────────────────────────
RESEND_API_KEY=""

# Set "true" to bypass auth (browsable demo). Set "false" once Supabase is set.
NEXT_PUBLIC_DISABLE_AUTH="true"
