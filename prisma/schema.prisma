// Buildora — Prisma schema
// Generated for the Buildora MVP.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─── ENUMS ────────────────────────────────────────────────────────

enum Role {
  OWNER
  ADMIN
  PROJECT_MANAGER
  SITE_MANAGER
  VIEWER
}

enum ConstructionMethod {
  REINFORCED_CONCRETE
  MASONRY_BLOCKWORK
  STEEL_FRAME
  TIMBER_FRAME
  PRECAST_CONCRETE
  MODULAR
  AAC_PANELS
  AAC_BLOCKS
  HYBRID
}

enum BuildingType {
  RESIDENTIAL_APARTMENT
  RESIDENTIAL_HOUSE
  COMMERCIAL_OFFICE
  COMMERCIAL_RETAIL
  INDUSTRIAL_WAREHOUSE
  MIXED_USE
  HOSPITALITY
  HEALTHCARE
  EDUCATION
  INFRASTRUCTURE
}

enum TaskStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
  DELAYED
  ON_HOLD
  CANCELLED
}

enum RaciRole {
  RESPONSIBLE
  ACCOUNTABLE
  CONSULTED
  INFORMED
}

enum PartyType {
  DEVELOPER
  GENERAL_CONTRACTOR
  SITE_MANAGER
  ARCHITECT
  STRUCTURAL_ENGINEER
  MEP_ENGINEER
  SUBCONTRACTOR
  SUPPLIER
  LOGISTICS
  FINANCE_CONTROLLER
  QUALITY_INSPECTOR
  AUTHORITY
}

enum ShipmentStatus {
  ORDERED
  IN_TRANSIT
  DELIVERED
  DELAYED
  CANCELLED
}

enum RiskLevel {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

// Primavera/MS-Project date-constraint semantics.
enum ConstraintType {
  SNET // Start No Earlier Than
  FNLT // Finish No Later Than
  MSO  // Must Start On
  MFO  // Must Finish On
}

// How close to critical an activity sits (§9). Not a binary flag.
enum CriticalityBand {
  CRITICAL
  NEAR_CRITICAL
  WATCH
  NORMAL
}

enum BaselineStatus {
  DRAFT
  APPROVED
  SUPERSEDED
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
}

enum TransportMode {
  ROAD
  SEA
  RAIL
  AIR
  MULTIMODAL
}

// Stages of the order-to-site chain (§18).
enum ProcurementLegKind {
  APPROVAL
  PURCHASE_ORDER
  PRODUCTION
  LOADING
  TRANSIT
  CUSTOMS
  DELIVERY
}

enum ProcurementStatus {
  PLANNED
  ORDERED
  IN_PRODUCTION
  IN_TRANSIT
  CUSTOMS
  DELIVERED
  CANCELLED
}

// ─── USERS & COMPANIES ────────────────────────────────────────────

model User {
  id        String   @id @default(cuid())
  authId    String   @unique
  email     String   @unique
  name      String
  phone     String?
  avatarUrl String?
  role      Role     @default(VIEWER)
  companyId String?
  company   Company? @relation(fields: [companyId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  projectMembers  ProjectMember[]
  raciAssignments RaciAssignment[]
  progressUpdates ProgressUpdate[]
  comments        Comment[]
}

model Company {
  id        String   @id @default(cuid())
  name      String
  country   String
  city      String?
  logoUrl   String?
  createdAt DateTime @default(now())

  users    User[]
  projects Project[]
  parties  Party[]
}

// ─── PROJECTS ─────────────────────────────────────────────────────

model Project {
  id                 String             @id @default(cuid())
  name               String
  code               String             @unique
  clientName         String?
  description        String?
  companyId          String
  company            Company            @relation(fields: [companyId], references: [id])
  country            String
  city               String
  address            String?
  latitude           Float?
  longitude          Float?
  buildingType       BuildingType
  constructionMethod ConstructionMethod
  totalAreaSqm       Float
  numberOfFloors     Int
  numberOfUnits      Int?
  numberOfBasements  Int                @default(0)
  startDate          DateTime
  targetEndDate      DateTime
  actualEndDate      DateTime?
  workingDaysPerWeek Int                @default(5)
  workingHoursPerDay Int                @default(8)
  status             String             @default("PLANNING")
  currency           String             @default("USD")
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  // §9 — configurable float bands, in working days.
  nearCriticalThresholdDays Int @default(5)
  watchThresholdDays        Int @default(10)

  // Default calendar applied to activities that do not name their own.
  defaultCalendarId String?
  defaultCalendar   Calendar? @relation("ProjectDefaultCalendar", fields: [defaultCalendarId], references: [id])

  members        ProjectMember[]
  buildings      Building[]
  workPackages   WorkPackage[]
  tasks          Task[]
  parties        ProjectParty[]
  budgets        Budget[]
  risks          Risk[]
  documents      Document[]
  milestones     Milestone[]
  publicHolidays PublicHoliday[]
  resources      Resource[]
  materials      Material[]
  calendars      Calendar[]        @relation("ProjectCalendars")
  baselines      Baseline[]
  revisions      ScheduleRevision[]
  auditLogs      AuditLog[]
  procurement    ProcurementPackage[]
  scenarios      Scenario[]
}

model ProjectMember {
  id        String  @id @default(cuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId    String
  user      User    @relation(fields: [userId], references: [id])
  role      Role

  @@unique([projectId, userId])
}

model PublicHoliday {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  date      DateTime
  name      String
}

// ─── BUILDINGS ────────────────────────────────────────────────────

model Building {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name      String
  floors    Int
  units     Int?
  areaSqm   Float
  createdAt DateTime @default(now())

  tasks Task[]
}

// ─── WORK PACKAGES & TASKS ────────────────────────────────────────

model WorkPackage {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  code      String
  name      String
  phase     String
  sortOrder Int
  color     String?
  parentId  String?
  parent    WorkPackage?  @relation("WPHierarchy", fields: [parentId], references: [id])
  children  WorkPackage[] @relation("WPHierarchy")
  createdAt DateTime      @default(now())

  tasks   Task[]
  budgets Budget[]
}

model Task {
  id               String      @id @default(cuid())
  projectId        String
  project          Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  workPackageId    String
  workPackage      WorkPackage @relation(fields: [workPackageId], references: [id])
  buildingId       String?
  building         Building?   @relation(fields: [buildingId], references: [id])
  code             String
  name             String
  description      String?
  phase            String
  plannedStartDate DateTime
  plannedEndDate   DateTime
  actualStartDate  DateTime?
  actualEndDate    DateTime?
  durationDays     Int
  progressPct      Float       @default(0)
  status           TaskStatus  @default(NOT_STARTED)
  isCritical       Boolean     @default(false)
  isMilestone      Boolean     @default(false)
  floatDays        Int         @default(0)
  crewSize         Int?
  productivityRate Float?
  quantityUnit     String?
  quantity         Float?
  notes            String?
  sortOrder        Int
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  // ── CPM results ────────────────────────────────────────────────
  // Persisted so that every date shown to a user can be traced back to the
  // forward/backward pass that produced it, rather than being unexplainable.
  earlyStartOffset  Int?
  earlyFinishOffset Int?
  lateStartOffset   Int?
  lateFinishOffset  Int?
  freeFloatDays     Int             @default(0)
  criticalityBand   CriticalityBand @default(NORMAL)

  // ── Date constraint (§34/§35) ──────────────────────────────────
  constraintType ConstraintType?
  constraintDate DateTime?

  // ── Progress (§25/§26) ─────────────────────────────────────────
  // % complete alone is not enough: 50% complete does not imply 50% of the
  // duration remains, so remaining duration is tracked independently.
  remainingDurationDays Int?
  actualQuantity        Float?

  // Per-activity calendar; falls back to the project default when unset.
  calendarId String?
  calendar   Calendar? @relation("TaskCalendar", fields: [calendarId], references: [id])

  predecessors        Dependency[]         @relation("SuccessorTask")
  successors          Dependency[]         @relation("PredecessorTask")
  raciAssignments     RaciAssignment[]
  progressUpdates     ProgressUpdate[]
  resourceAllocations ResourceAllocation[]
  shipmentTasks       ShipmentTask[]
  comments            Comment[]
  baselineTasks       BaselineTask[]
  procurement         ProcurementPackage[] @relation("TaskProcurement")

  @@unique([projectId, code])
  @@index([projectId, sortOrder])
  @@index([projectId, criticalityBand])
}

model Dependency {
  id            String @id @default(cuid())
  predecessorId String
  predecessor   Task   @relation("PredecessorTask", fields: [predecessorId], references: [id], onDelete: Cascade)
  successorId   String
  successor     Task   @relation("SuccessorTask", fields: [successorId], references: [id], onDelete: Cascade)
  type          String @default("FS")
  lagDays       Int    @default(0)

  @@unique([predecessorId, successorId])
}

// ─── PARTIES & RACI ───────────────────────────────────────────────

model Party {
  id           String    @id @default(cuid())
  companyId    String?
  company      Company?  @relation(fields: [companyId], references: [id])
  name         String
  type         PartyType
  contactName  String?
  contactEmail String?
  contactPhone String?
  country      String?
  createdAt    DateTime  @default(now())

  projectParties  ProjectParty[]
  raciAssignments RaciAssignment[]
  supplierRecords Supplier[]
}

model ProjectParty {
  id        String  @id @default(cuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  partyId   String
  party     Party   @relation(fields: [partyId], references: [id])
  role      String?

  @@unique([projectId, partyId])
}

model RaciAssignment {
  id        String   @id @default(cuid())
  taskId    String
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  partyId   String?
  party     Party?   @relation(fields: [partyId], references: [id])
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  raciRole  RaciRole
  createdAt DateTime @default(now())
}

// ─── RESOURCES ────────────────────────────────────────────────────

model Resource {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name      String
  type      String
  unit      String
  unitCost  Float
  currency  String   @default("USD")
  createdAt DateTime @default(now())

  // §15 — how many of this resource can run concurrently. Used to detect the
  // impossible overlapping assignments described in §14.
  capacity Int @default(1)

  // §10 — resources may work a different calendar from the project default.
  calendarId String?
  calendar   Calendar? @relation("ResourceCalendar", fields: [calendarId], references: [id])

  allocations ResourceAllocation[]
}

model ResourceAllocation {
  id         String   @id @default(cuid())
  taskId     String
  task       Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  resourceId String
  resource   Resource @relation(fields: [resourceId], references: [id])
  quantity   Float
  units      String
}

// ─── LOGISTICS ────────────────────────────────────────────────────

model Supplier {
  id            String   @id @default(cuid())
  partyId       String
  party         Party    @relation(fields: [partyId], references: [id])
  material      String
  leadTimeDays  Int
  moq           Float?
  moqUnit       String?
  countryOrigin String?
  createdAt     DateTime @default(now())

  shipments Shipment[]
  procurementPackages ProcurementPackage[]
}

model Material {
  id           String    @id @default(cuid())
  projectId    String
  project      Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name         String
  spec         String?
  unit         String
  totalQty     Float
  orderedQty   Float     @default(0)
  deliveredQty Float     @default(0)
  requiredDate DateTime?
  supplierId   String?
  unitCost     Float?
  createdAt    DateTime  @default(now())

  shipments ShipmentMaterial[]
}

model Shipment {
  id               String         @id @default(cuid())
  supplierId       String
  supplier         Supplier       @relation(fields: [supplierId], references: [id])
  orderDate        DateTime
  expectedDelivery DateTime
  actualDelivery   DateTime?
  status           ShipmentStatus @default(ORDERED)
  notes            String?
  createdAt        DateTime       @default(now())

  materials ShipmentMaterial[]
  tasks     ShipmentTask[]
}

model ShipmentMaterial {
  id         String   @id @default(cuid())
  shipmentId String
  shipment   Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  materialId String
  material   Material @relation(fields: [materialId], references: [id])
  quantity   Float
}

model ShipmentTask {
  id         String   @id @default(cuid())
  shipmentId String
  shipment   Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  taskId     String
  task       Task     @relation(fields: [taskId], references: [id])
}

// ─── BUDGET & COSTS ───────────────────────────────────────────────

model Budget {
  id            String       @id @default(cuid())
  projectId     String
  project       Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  workPackageId String?
  workPackage   WorkPackage? @relation(fields: [workPackageId], references: [id])
  name          String
  estimatedCost Float
  committedCost Float        @default(0)
  actualCost    Float        @default(0)
  forecastCost  Float        @default(0)
  currency      String       @default("USD")
  category      String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  costs Cost[]
}

model Cost {
  id          String   @id @default(cuid())
  budgetId    String
  budget      Budget   @relation(fields: [budgetId], references: [id], onDelete: Cascade)
  description String
  amount      Float
  type        String
  date        DateTime
  invoiceRef  String?
  createdAt   DateTime @default(now())
}

// ─── PROGRESS ─────────────────────────────────────────────────────

model ProgressUpdate {
  id          String   @id @default(cuid())
  taskId      String
  task        Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  date        DateTime
  progressPct Float
  notes       String?
  photoUrls   String[]
  createdAt   DateTime @default(now())
}

// ─── MILESTONES ───────────────────────────────────────────────────

model Milestone {
  id          String    @id @default(cuid())
  projectId   String
  project     Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name        String
  plannedDate DateTime
  actualDate  DateTime?
  achieved    Boolean   @default(false)
  description String?
  createdAt   DateTime  @default(now())
}

// ─── RISKS ────────────────────────────────────────────────────────

model Risk {
  id          String    @id @default(cuid())
  projectId   String
  project     Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title       String
  description String?
  level       RiskLevel @default(MEDIUM)
  probability Float
  impact      Float
  riskScore   Float
  category    String?
  owner       String?
  mitigation  String?
  status      String    @default("OPEN")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

// ─── DOCUMENTS ────────────────────────────────────────────────────

model Document {
  id         String   @id @default(cuid())
  projectId  String
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name       String
  type       String
  url        String
  uploadedBy String
  createdAt  DateTime @default(now())
}

// ─── CALENDARS (§10) ──────────────────────────────────────────────

// A named working calendar. `workingWeek` is a 7-slot mask where index 0 is
// Sunday, so Mon–Fri, Mon–Sat, 4-day weeks and shift patterns are all
// expressible. Several calendars can coexist per project and be attached to
// individual activities or resources.
model Calendar {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation("ProjectCalendars", fields: [projectId], references: [id], onDelete: Cascade)
  name      String
  isDefault Boolean  @default(false)
  // Index 0 = Sunday … 6 = Saturday.
  workingWeek  Boolean[]
  hoursPerDay  Float    @default(8)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  exceptions         CalendarException[]
  tasks              Task[]              @relation("TaskCalendar")
  defaultForProjects Project[]           @relation("ProjectDefaultCalendar")
  resources          Resource[]          @relation("ResourceCalendar")

  @@unique([projectId, name])
}

// Overrides the weekly pattern for a single date. `working = false` marks a
// holiday or shutdown; `working = true` marks an added recovery day.
model CalendarException {
  id         String   @id @default(cuid())
  calendarId String
  calendar   Calendar @relation(fields: [calendarId], references: [id], onDelete: Cascade)
  date       DateTime
  working    Boolean  @default(false)
  name       String?

  @@unique([calendarId, date])
}

// ─── BASELINES (§23/§24) ──────────────────────────────────────────

// A frozen snapshot of the schedule. Once approved it must never change
// silently — variance is always measured against it.
model Baseline {
  id          String         @id @default(cuid())
  projectId   String
  project     Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name        String
  status      BaselineStatus @default(DRAFT)
  approvedAt  DateTime?
  approvedBy  String?
  notes       String?
  createdAt   DateTime       @default(now())

  tasks BaselineTask[]

  @@unique([projectId, name])
}

// A snapshot row is self-contained: it carries the code, name and dates it was
// captured with, so it survives the live task being deleted or regenerated.
// The link back to the live task is a convenience, not the record — cascading
// from it would silently empty an approved baseline (§23).
model BaselineTask {
  id         String   @id @default(cuid())
  baselineId String
  baseline   Baseline @relation(fields: [baselineId], references: [id], onDelete: Cascade)
  taskId     String?
  task       Task?    @relation(fields: [taskId], references: [id], onDelete: SetNull)

  code          String
  name          String
  startDate     DateTime
  endDate       DateTime
  durationDays  Int
  floatDays     Int      @default(0)
  isCritical    Boolean  @default(false)

  @@unique([baselineId, code])
}

// ─── SCHEDULE REVISIONS (§24) ─────────────────────────────────────

model ScheduleRevision {
  id          String   @id @default(cuid())
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  revisionNo  Int
  author      String?
  reason      String?
  changeCount Int      @default(0)
  approved    Boolean  @default(false)
  approvedBy  String?
  approvedAt  DateTime?
  createdAt   DateTime @default(now())

  @@unique([projectId, revisionNo])
}

// ─── AUDIT TRAIL (§45) ────────────────────────────────────────────

model AuditLog {
  id        String      @id @default(cuid())
  projectId String
  project   Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId    String?
  action    AuditAction
  entity    String // "Task", "Dependency", "Baseline", …
  entityId  String
  field     String?
  oldValue  String?
  newValue  String?
  reason    String?
  createdAt DateTime    @default(now())

  @@index([projectId, createdAt])
  @@index([entity, entityId])
}

// ─── PROCUREMENT & LOGISTICS (§16–§18) ────────────────────────────

// A material package tied to the activity that consumes it. The required-on-
// site date is NOT stored: it is the consuming task's start date, so it moves
// automatically whenever the schedule moves.
model ProcurementPackage {
  id        String  @id @default(cuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  code      String
  material  String
  spec      String?

  supplierId String?
  supplier   Supplier? @relation(fields: [supplierId], references: [id])

  // Logistics context (§18)
  origin        String?
  destination   String?
  transportMode TransportMode?

  /// Activity that needs the material on site.
  consumingTaskId String?
  consumingTask   Task?   @relation("TaskProcurement", fields: [consumingTaskId], references: [id])

  /// Contingency held before the required-on-site date, in calendar days.
  bufferDays Int @default(0)

  /// Confirmed or forecast arrival. Null means genuinely unknown, not zero.
  currentEtaDate DateTime?
  orderedDate    DateTime?

  status    ProcurementStatus @default(PLANNED)
  quantity  Float?
  unit      String?
  notes     String?
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  legs ProcurementLeg[]

  @@unique([projectId, code])
  @@index([projectId, status])
}

// One stage of the chain. Durations are CALENDAR days — freight does not
// observe the site working week.
model ProcurementLeg {
  id        String             @id @default(cuid())
  packageId String
  package   ProcurementPackage @relation(fields: [packageId], references: [id], onDelete: Cascade)
  kind      ProcurementLegKind
  name      String
  days      Int
  sequence  Int

  @@index([packageId, sequence])
}

// ─── SCENARIOS (§21) ──────────────────────────────────────────────

// A what-if variant of the schedule. Changes are stored, never applied to the
// live tasks — evaluating a scenario re-solves a copy of the network, so the
// approved baseline is never disturbed.
model Scenario {
  id          String   @id @default(cuid())
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name        String
  description String?
  /// Cached result of the last evaluation, in working days.
  finishShiftDays Int?
  isFeasible      Boolean?
  evaluatedAt     DateTime?
  createdBy       String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  changes ScenarioChange[]

  @@unique([projectId, name])
}

model ScenarioChange {
  id         String   @id @default(cuid())
  scenarioId String
  scenario   Scenario @relation(fields: [scenarioId], references: [id], onDelete: Cascade)
  /// DURATION_DELTA | DURATION_SET | LAG_SET | DEPENDENCY_TYPE | CONSTRAINT
  kind            String
  taskCode        String
  predecessorCode String?
  value           Float
  dependencyType  String?
  constraintType  String?
  note            String?
}

// ─── COMMENTS ─────────────────────────────────────────────────────

model Comment {
  id        String   @id @default(cuid())
  taskId    String
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  body      String
  createdAt DateTime @default(now())
}
